<Window x:Class="HomeLibrary.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeLibrary.ViewModels"
        Title="Домашняя библиотека" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Найти" Command="{Binding SearchCommand}"
                    Width="80" DockPanel.Dock="Right" Margin="10,0,0,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Command="{Binding AddBookCommand}" Width="100" Margin="0,0,5,0"/>
            <Button Content="Редактировать" Command="{Binding EditBookCommand}" Width="120" Margin="0,0,5,0"/>
            <Button Content="Удалить" Command="{Binding DeleteBookCommand}" Width="100"/>
        </StackPanel>

        <!-- Список книг -->
        <ListView Grid.Row="2" ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Автор" DisplayMemberBinding="{Binding Author}" Width="180"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="280"/>
                    <GridViewColumn Header="Год" DisplayMemberBinding="{Binding PublishYear}" Width="70"/>
                    <GridViewColumn Header="Страниц" DisplayMemberBinding="{Binding PageCount}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <TextBlock Text="{Binding Books.Count, StringFormat='Всего книг: {0}'}"/>
        </StatusBar>
    </Grid>
</Window>