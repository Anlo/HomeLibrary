<Window x:Class="HomeLibrary.Views.BookEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Карточка книги" Height="600" Width="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поля книги -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Автор:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Book.Author, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Год издания:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Book.PublishYear, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Book.Title, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Кол-во страниц:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Book.PageCount, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
        </Grid>

        <!-- HTML-редактор оглавления (WebView2 + TinyMCE) -->
        <GroupBox Grid.Row="1" Header="Оглавление (HTML → XML)">
            <wv2:WebView2 x:Name="HtmlEditor"/>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Отмена" Width="100"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>